        "token": "synthetic-token"
      },
      "confirmed": true,
      "parameters": {
        "id": 1
      },
      "data": {
        "streamSettings": {
          "network": "xhttp",
          "security": "tls",
          "customFutureField": {
            "value": true
          }
        }
      },
      "precondition": {
        "operation": "get_panel_api_inbounds_get_id",
        "parameters": {
          "id": 1
        },
        "revision": "synthetic-revision"
      }
    },
    "expected": {
      "instanceId": "docker:fixture",
      "operation": "post_panel_api_inbounds_update_id",
      "auth": {
        "token": "synthetic-token"
      },
      "confirmed": true,
      "parameters": {
        "id": 1
      },
      "data": {
        "streamSettings": {
          "network": "xhttp",
          "security": "tls",
          "customFutureField": {
            "value": true
          }
        }
      },
      "precondition": {
        "operation": "get_panel_api_inbounds_get_id",
        "parameters": {
          "id": 1
        },
        "revision": "synthetic-revision"
      }
    }
  },
