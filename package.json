{
  "name": "5a-ui",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Flutter 跨平台 3x-ui / 3m-ui 部署与管理",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "fvm dart run tool/dev.dart",
    "dev": "fvm dart run tool/dev.dart",
    "generate": "fvm dart run tool/generate.dart",
    "build": "bash scripts/build-web.sh && tsc --noEmit",
    "build:worker": "tsx scripts/build-worker.ts",
    "check": "fvm dart run tool/generate.dart --check && tsc --noEmit",
    "test": "vitest run",
    "test:cfnew-runtime": "tsx scripts/smoke-cfnew.ts",
    "test:worker": "tsx scripts/smoke-worker-ssh.ts",
    "test:remote": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "dev:cloudflare": "wrangler dev",
    "deploy:cloudflare": "pnpm build && wrangler deploy",
    "check:cloudflare": "pnpm build && wrangler deploy --dry-run --outdir .tmp/worker-check",
    "test:ssh": "node tests/ssh-fixture.mjs"
  },
  "dependencies": {
    "ipaddr.js": "2.5.0",
    "ssh2": "1.17.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261014.1",
    "@types/node": "26.6.5",
    "@types/ssh2": "1.15.6",
    "esbuild": "0.28.2",
    "miniflare": "5.20261012.0-beta",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "wrangler": "4.151.0"
  }
}
