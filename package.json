{
  "name": "huarunying",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "无需注册，一键在自己的服务器上部署 VLESS + REALITY。",
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "start": "tsx scripts/dev.ts",
    "dev": "tsx scripts/dev.ts",
    "generate": "tsx scripts/embed-remote.ts",
    "build": "pnpm generate && tsc --noEmit && vite build",
    "build:worker": "pnpm generate && tsx scripts/build-worker.ts",
    "check": "tsx scripts/embed-remote.ts --check && tsc --noEmit",
    "test": "vitest run",
    "test:worker": "tsx scripts/smoke-worker-ssh.ts",
    "test:remote": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "dev:cloudflare": "wrangler dev",
    "deploy:cloudflare": "pnpm build && wrangler deploy",
    "check:cloudflare": "pnpm build && wrangler deploy --dry-run --outdir .tmp/worker"
  },
  "dependencies": {
    "ipaddr.js": "2.5.0",
    "lucide-react": "1.57.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ssh2": "1.17.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261014.1",
    "@types/node": "26.6.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ssh2": "1.15.6",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "miniflare": "5.20261012.0-beta",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "wrangler": "4.151.0"
  }
}
