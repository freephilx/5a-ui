{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "huarunying",
  "main": ".tmp/worker/index.mjs",
  "no_bundle": true,
  "keep_vars": true,
  "compatibility_date": "2026-10-14",
  "compatibility_flags": ["nodejs_compat"],
  "build": { "command": "pnpm build:worker" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "ratelimits": [
    { "name": "REQUEST_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    { "name": "INSTALL_LIMITER", "namespace_id": "1002", "simple": { "limit": 3, "period": 60 } }
  ],
  "observability": { "enabled": false }
}
